{
  "name": "cuetuck-desktop",
  "private": true,
  "version": "0.1.0-beta.8",
  "type": "module",
  "scripts": {
    "build:local": "node ../scripts/release-check.mjs && tauri build --debug --bundles app --config src-tauri/tauri.local.conf.json",
    "build:preview": "node ../scripts/release-check.mjs --preview && tauri build --bundles app,dmg --config src-tauri/tauri.preview.conf.json",
    "build:release": "node ../scripts/release-check.mjs --production && tauri build",
    "test:browser": "node ../scripts/browser-smoke.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:nsis": "tauri build --bundles nsis"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.0",
    "semver": "^7.8.5",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.19",
    "@tauri-apps/cli": "^2.5.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "vite": "^6.0.3",
    "vitest": "^3.0.5"
  }
}
