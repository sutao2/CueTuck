# 本机已启动 PromptLauncher compose（Postgres 5432 / Redis 6379 / MinIO 9000）时：
PROMPTARK_DATABASE_URL=postgres://pl:pl@127.0.0.1:5432/promptark?sslmode=disable
PROMPTARK_REDIS_URL=redis://127.0.0.1:6379
PROMPTARK_MEDIA_ENDPOINT=http://127.0.0.1:9000
PROMPTARK_MEDIA_ACCESS_KEY=minio
PROMPTARK_MEDIA_SECRET_KEY=minio123
PROMPTARK_MEDIA_BUCKET=prompt-launcher-media
# 表结构异常先排查迁移，不要重置业务 schema；恢复见 docs/how-to/backend-recovery.md。
# 首次初始化：非开发实例须显式配置邮箱和至少 12 字符密码（已有账号不会被覆盖）。
# PROMPTARK_ADMIN_EMAIL=owner@example.com
# PROMPTARK_ADMIN_PASSWORD=<在服务器安全地设置，不提交仓库>
# 仅本机开发可启用默认测试账号：
# PROMPTARK_ALLOW_DEV_USER=1
# 也可复用旧 OAuth 变量：PL_GOOGLE_CLIENT_ID / PL_GITHUB_CLIENT_ID 等
# Google/GitHub 的应用凭据可直接在管理端「第三方登录」配置。
# 可选：固定服务器加密密钥文件路径；默认后端工作目录下 .promptark/oauth.key
# PROMPTARK_OAUTH_KEY_FILE=/secure/path/promptark-oauth.key
# 支付 mock（需导出到启动进程环境，本示例不自动加载）
PROMPTARK_BILLING_MOCK=1
## 旧库首次启用固定角色时，明确指定现有管理员为 owner；一次迁移，不修改密码。
# PROMPTARK_OWNER_EMAIL=admin@promptark.local
