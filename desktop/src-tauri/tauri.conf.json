{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CueTuck",
  "version": "0.1.0-beta.22",
  "identifier": "app.promptark.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": false,
        "title": "唤词",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 520,
        "visible": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 13
        }
      },
      {
        "label": "launcher",
        "title": "唤词启动器",
        "url": "launcher.html",
        "width": 620,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": true,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFRjRGMjYxODlGNUU5QjAKUldTdzZmV0pZZkwwTHZrUkJGRlZkdFM4RkU3VzV5c1FPOVFGdTdBT0xMcm9wckF1Nk5COGhpSzkK",
      "endpoints": [
        "https://github.com/sutao2/CueTuck/releases/latest/download/latest.json"
      ]
    }
  }
}
